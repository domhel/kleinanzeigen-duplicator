{
  "manifest_version": 3,
  "name": "Kleinanzeigen Inserat-Duplikator",
  "version": "1.0.0",
  "description": "Kopiert ein bestehendes Kleinanzeigen-Inserat in ein neues Inserat.",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.kleinanzeigen.de/*",
    "https://kleinanzeigen.de/*",
    "https://*.kleinanzeigen.de/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kleinanzeigen-duplicator@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inserat duplizieren"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kleinanzeigen.de/*",
        "https://kleinanzeigen.de/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}